{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "bash ~/.claude/hooks/block-destructive-git.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
